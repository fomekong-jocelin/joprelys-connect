{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.eco.example/v1/consent.schema.json",
  "title": "Consent",
  "description": "FHIR R4 restricted Consent: basis of every cross-application read. A revoked consent carries a revocation block; an active one does not.",
  "type": "object",
  "additionalProperties": false,
  "required": ["resourceType", "id", "meta", "status", "scope", "patient", "grantee", "period", "dateTime"],
  "properties": {
    "resourceType": { "const": "Consent" },
    "id": { "type": "string", "format": "uuid" },
    "meta": { "$ref": "https://contracts.eco.example/v1/meta.schema.json" },
    "status": { "enum": ["active", "revoked"] },
    "scope": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["prescriptions", "lab-results", "immunizations", "appointments", "emergency-summary"] }
    },
    "patient": { "type": "string", "pattern": "^PatientLink/[0-9a-f-]{36}$" },
    "grantee": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "reference"],
      "properties": {
        "type": { "enum": ["application", "organization", "practitioner"] },
        "reference": { "type": "string", "minLength": 1, "maxLength": 200 }
      }
    },
    "period": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start"],
      "properties": {
        "start": { "type": "string", "format": "date-time" },
        "end": { "type": "string", "format": "date-time" }
      }
    },
    "dateTime": { "type": "string", "format": "date-time" },
    "revocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revokedAt", "revokedBy"],
      "properties": {
        "revokedAt": { "type": "string", "format": "date-time" },
        "revokedBy": { "$ref": "#/$defs/revokedBy" },
        "reason": { "type": "string", "maxLength": 200 }
      }
    }
  },
  "if": { "properties": { "status": { "const": "revoked" } } },
  "then": { "required": ["revocation"] },
  "else": { "not": { "required": ["revocation"] } },
  "$defs": {
    "revokedBy": { "enum": ["patient", "guardian", "system"] }
  }
}
