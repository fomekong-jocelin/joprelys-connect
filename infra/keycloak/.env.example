# Modèle des variables de Joprelys ID (Keycloak) en dev. Copier vers .env à la racine du dépôt
# puis remplacer chaque valeur. Le fichier .env est ignoré par git : n'y mettre que des valeurs de dev.
# Générer une valeur aléatoire : openssl rand -base64 32
KEYCLOAK_DB_PASSWORD=
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=
# Secret du client confidentiel allopharma-server (client credentials). Même valeur côté AllôPharma.
ALLOPHARMA_SERVER_CLIENT_SECRET=
# Mot de passe commun des comptes patients fictifs patient.demo1 / patient.demo2.
JOPRELYS_ID_TEST_USER_PASSWORD=
