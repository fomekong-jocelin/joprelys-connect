@import "tailwindcss";
@import "./styles/design-system.theme.css";

/*
  Tailwind CSS v4 uniquement.
  Ne pas utiliser @tailwind base/components/utilities : syntaxe v3.
  Ne pas utiliser tailwind.config.js pour les tokens applicatifs sauf ADR.
*/

:root {
  color-scheme: light;
}

:root[data-theme="dark"] {
  color-scheme: dark;
}
