#!/bin/sh
# Bloque un commit qui contient un secret (jeton, mot de passe, clé d'API).
# Activation, une fois par clone : git config core.hooksPath .githooks
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "gitleaks introuvable : installez-le (https://github.com/gitleaks/gitleaks) pour protéger vos commits." >&2
  exit 1
fi
exec gitleaks git --staged --redact --no-banner --config .gitleaks.toml
