# ==========================================================
# .gitignore — Projet Spring Boot / Angular / Flutter
# Standard Joprelys AI + Scrum Governance Kit
# ==========================================================

# OS / System
.DS_Store
Thumbs.db
desktop.ini

# IDE / Editors
.idea/
*.iml
*.ipr
*.iws
.vscode/*
!.vscode/extensions.json
!.vscode/settings.example.json
.project
.classpath
.settings/

# Logs / Runtime
logs/
*.log
*.tmp
*.temp
tmp/
temp/
*.pid
storage/
backend/storage/

# Secrets / Environment
.env
.env.*
!.env.example
*.keystore
*.jks
*.p12
*.pem
*.key
*.crt
secrets/
credentials/
application-local.yml
application-secret.yml
application-secrets.yml

# Java / Spring Boot / Maven
target/
.mvn/timing.properties
hs_err_pid*
replay_pid*
*.class

# Maven wrapper should generally remain versioned:
# !mvnw
# !mvnw.cmd
# !.mvn/wrapper/maven-wrapper.properties

# Angular / Node / Tailwind CSS v4
node_modules/
dist/
.angular/
.cache/
.npm/
coverage/
.nyc_output/
*.tsbuildinfo

# Angular proxy policy
# proxy.conf.json should normally be committed.
proxy.local.conf.json
proxy.*.local.json

# Flutter / Dart
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
build/
coverage/

# Android / Gradle generated files in Flutter modules
**/android/.gradle/
**/android/app/build/
**/android/build/
**/android/local.properties

# iOS / Xcode generated files
**/ios/Pods/
**/ios/.symlinks/
**/ios/Flutter/Flutter.framework
**/ios/Flutter/Flutter.podspec
**/ios/Flutter/Generated.xcconfig
**/ios/Flutter/ephemeral/
**/ios/Runner.xcworkspace/
**/ios/build/
**/*.xcuserstate
**/*.xcuserdata/

# Flutter desktop generated files
**/macos/Flutter/ephemeral/
**/linux/flutter/ephemeral/
**/windows/flutter/ephemeral/

# Test / Reports / QA
reports/
test-results/
joprelys_server_diagnostic_*.txt
playwright-report/
cypress/screenshots/
cypress/videos/
allure-results/
allure-report/

# Build artifacts / Archives
*.zip
*.tar
*.tar.gz
*.rar
*.7z
*.war
*.jar
*.ear
*.apk
*.aab
*.ipa

# Generated docs / Local exports
site/
.public/
.local/
exports/
generated/

# AI / Local agent scratchpads
.ai-cache/
.ai-tmp/
.m2-test-cache/
.codex/
.claude/cache/
.gemini/cache/
*.scratch.md

# Python diagnostic tooling
__pycache__/
*.py[cod]
