@tailwind base;
@tailwind components;
@tailwind utilities;

:root {
  --color-brand-50: 239 246 255;
  --color-brand-500: 59 130 246;
  --color-brand-700: 29 78 216;
  --radius-app: 0.75rem;
}

:root.dark {
  --color-brand-50: 15 23 42;
  --color-brand-500: 96 165 250;
  --color-brand-700: 147 197 253;
}
